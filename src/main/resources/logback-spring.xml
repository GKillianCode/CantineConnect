<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Includes Spring Boot’s default variables and colors -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml" />

  <!-- ======================================================= -->
  <!-- DEFAULT profile (fallback if no profile is active)      -->
  <!-- ======================================================= -->
  <springProfile name="default">
    <appender name="CONSOLE_DEFAULT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>${CONSOLE_LOG_PATTERN}</pattern>
      </encoder>
    </appender>

    <logger name="fr.killiangodet.cantineconnect.billing" level="INFO" />
    <logger name="fr.killiangodet.cantineconnect.booking" level="INFO" />
    <logger name="fr.killiangodet.cantineconnect.inventory" level="INFO" />

    <root level="INFO">
      <appender-ref ref="CONSOLE_DEFAULT" />
    </root>
  </springProfile>

  <!-- ======================================================= -->
  <!-- DEV Profil                                              -->
  <!-- ======================================================= -->
  <springProfile name="dev">
    <appender name="CONSOLE_DEV" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%clr(%d{HH:mm:ss.SSS}){faint} [%thread] %clr(%-5level){HIGHLIGHT} %clr(%logger{36}){cyan} - %msg%n%ex</pattern>
      </encoder>
    </appender>

    <logger name="fr.killiangodet.cantineconnect.billing" level="DEBUG" />
    <logger name="fr.killiangodet.cantineconnect.booking" level="DEBUG" />
    <logger name="fr.killiangodet.cantineconnect.inventory" level="DEBUG" />
    <logger name="org.springframework.batch" level="INFO" />

    <root level="INFO">
      <appender-ref ref="CONSOLE_DEV" />
    </root>
  </springProfile>

  <!-- ======================================================= -->
  <!-- PROD Profil                                             -->
  <!-- ======================================================= -->
  <springProfile name="prod">
    <appender name="FILE_PROD" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>logs/app.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>logs/archived/app-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
        <maxFileSize>10MB</maxFileSize>
        <maxHistory>30</maxHistory>
      </rollingPolicy>
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n%ex{full}</pattern>
      </encoder>
    </appender>

    <logger name="fr.killiangodet.cantineconnect.billing" level="INFO" />
    <logger name="fr.killiangodet.cantineconnect.booking" level="INFO" />
    <logger name="fr.killiangodet.cantineconnect.inventory" level="INFO" />
    <logger name="org.springframework.batch" level="WARN" />

    <root level="WARN">
      <appender-ref ref="FILE_PROD" />
    </root>
  </springProfile>

</configuration>
